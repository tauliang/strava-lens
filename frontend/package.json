    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
