  "components": {
    "schemas": {
      "ActivatedSnapshot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ActivatedSnapshot"
      },
      "Body_upload_api_imports_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_imports_post"
      },
      "Configuration": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "UTC"
          },
          "exact_gps": {
            "type": "boolean",
            "title": "Exact Gps",
            "default": false
          },
          "hr_zones": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                }
              ]
            },
            "type": "array",
            "maxItems": 10,
            "title": "Hr Zones"
          },
          "goals": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Goals"
          },
          "gear_thresholds": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Gear Thresholds"
          },
          "overrides": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Overrides"
          },
          "privacy_zones": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Privacy Zones"
          },
          "cadence_convention": {
            "type": "string",
            "title": "Cadence Convention",
            "default": "source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Configuration"
      },
      "ConfigurationUpdateResponse": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "UTC"
          },
          "exact_gps": {
            "type": "boolean",
            "title": "Exact Gps",
            "default": false
          },
          "hr_zones": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                }
              ]
            },
            "type": "array",
            "maxItems": 10,
            "title": "Hr Zones"
          },
          "goals": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Goals"
          },
          "gear_thresholds": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Gear Thresholds"
          },
          "overrides": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Overrides"
          },
          "privacy_zones": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Privacy Zones"
          },
          "cadence_convention": {
            "type": "string",
            "title": "Cadence Convention",
            "default": "source"
          },
          "requires_reimport": {
            "type": "boolean",
            "title": "Requires Reimport"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requires_reimport"
        ],
        "title": "ConfigurationUpdateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportJobResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "ready",
              "failed"
            ],
            "title": "Status"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "snapshot_id",
          "created_at",
          "updated_at",
          "attempts",
          "progress",
          "error"
        ],
        "title": "ImportJobResponse",
        "description": "Public job state excludes private archive paths and persisted configuration."
      },
      "SnapshotResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "manifest": {
            "additionalProperties": true,
            "type": "object",
            "title": "Manifest"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at",
          "manifest",
          "active"
        ],
        "title": "SnapshotResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
